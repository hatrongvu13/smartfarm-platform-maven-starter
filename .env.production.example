# Biến môi trường production. CHỈ có tên, không có giá trị: giá trị thật lấy từ secret manager.
# Sinh giá trị ngẫu nhiên: scripts/generate-secret.sh. Danh sách lấy từ application{,-prod,-mtls}.yml của từng service.
# Dòng có "# mặc định" là tùy chọn; các dòng còn lại bắt buộc ở prod.

SPRING_PROFILES_ACTIVE=prod            # prod tự bật mtls

# --- Dùng chung -------------------------------------------------------------
IDENTITY_ISSUER=                       # URL issuer công khai của identity (https://...)
FARMVERSE_MTLS_DIR=                    # thư mục chứa ca.crt + <service>.crt/.key (mount từ CA / cert-manager)
# Trong container (Dockerfile): SERVER_PORT=8080, MANAGEMENT_SERVER_PORT=9090 đã đặt sẵn.
# Cổng ứng dụng mặc định bind 127.0.0.1: trong container phải đặt *_BIND_ADDRESS=0.0.0.0.
# Trace (M7, ADR-0012). Không đặt biến endpoint với giá trị rỗng: Boot coi rỗng là "đã đặt" và vẫn tạo exporter.
# TRACING_SAMPLING_PROBABILITY=0.1                                        # mặc định 0.1
# MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces   # bỏ dòng = không xuất trace

# --- api-gateway ------------------------------------------------------------
GATEWAY_BIND_ADDRESS=                  # mặc định 127.0.0.1
GATEWAY_TRUSTED_PROXIES=               # BẮT BUỘC: IP/CIDR của edge TLS, vd 10.0.0.0/8 (thiếu thì gateway không khởi động ở prod)
GATEWAY_CLIENT_SECRET=                 # trùng với identity
IDENTITY_URL=                          # URL nội bộ của identity (mTLS)
FARM_URL=                              # URL nội bộ của farm (mTLS)
WEB_URL=                               # nơi phục vụ SPA
REDIS_HOST=
REDIS_PORT=                            # mặc định 6379
REDIS_PASSWORD=
REDIS_SSL=                             # mặc định true ở prod
SPRING_DATA_REDIS_USERNAME=            # ACL user riêng của gateway
REDIS_TIMEOUT=                         # mặc định 2s
REDIS_CONNECT_TIMEOUT=                 # mặc định 1s
GATEWAY_SESSION_TIMEOUT=               # mặc định 30m

# --- identity-service -------------------------------------------------------
IDENTITY_BIND_ADDRESS=                 # mặc định 127.0.0.1
IDENTITY_GRPC_BIND_ADDRESS=            # mặc định 127.0.0.1; trong container đặt 0.0.0.0 (farm gọi gRPC)
IDENTITY_GRPC_PORT=                    # mặc định 9093
IDENTITY_DB_URL=
IDENTITY_DB_USER=                      # vai trò ứng dụng, chỉ DML (vd identity_app)
IDENTITY_DB_PASSWORD=
IDENTITY_DB_MIGRATION_USER=            # vai trò sở hữu schema, Flyway dùng (vd identity_owner)
IDENTITY_DB_MIGRATION_PASSWORD=
IDENTITY_KEY_ID=
IDENTITY_PRIVATE_KEY_PATH=
IDENTITY_PUBLIC_KEY_PATH=
IDENTITY_MFA_ENCRYPTION_PASSWORD=
IDENTITY_MFA_ENCRYPTION_SALT=
GATEWAY_PUBLIC_URL=                    # dựng redirect URI của client gateway
SERVICE_CLIENT_SECRET=                 # client_credentials nội bộ
IDENTITY_ADMIN_EMAIL=                  # chỉ lần khởi tạo đầu
IDENTITY_ADMIN_PASSWORD=               # chỉ lần khởi tạo đầu; xóa sau khi đã có admin

# --- farm-service -----------------------------------------------------------
FARM_BIND_ADDRESS=                     # mặc định 127.0.0.1
FARM_DB_URL=
FARM_DB_USER=                          # vai trò ứng dụng, chỉ DML (vd farm_app)
FARM_DB_PASSWORD=
FARM_DB_MIGRATION_USER=                # vai trò sở hữu schema, Flyway dùng (vd farm_owner)
FARM_DB_MIGRATION_PASSWORD=
IDENTITY_JWKS_URI=                     # URL nội bộ /oauth2/jwks của identity (mTLS)
FARM_ACCEPTED_AUDIENCES=               # mặc định farm-service; chỉ đổi khi chuyển đổi audience (ADR-0006)
