# SmartFarm unified test suite — environment template.
# Copy to test.env and fill in. test.env is gitignored; NEVER commit real secrets.
#
#   cp scripts/config/test.env.example scripts/config/test.env
#
# All values are verified against the SmartFarm source (gateway + services).
# The gateway (:8080) is the single ingress: REST under /api/v1/*, GraphQL at
# /graphql, auth proxied at /api/v1/auth/*.

# --- Core endpoints -----------------------------------------------------------
# Gateway base URL (ingress). server.port=8080 in apps/smartfarm-gateway/application.yml.
API_GATEWAY_URL=http://localhost:8080
# GraphQL endpoint. spring.graphql.http.path=/graphql on the gateway.
GRAPHQL_URL=http://localhost:8080/graphql
# Auth base — login/MFA are proxied through the gateway (AuthProxyController).
AUTH_BASE_URL=http://localhost:8080

# --- Credentials (login body is {tenantId,email,password}) --------------------
# Leave blank to run only unauthenticated checks (health, smoke, introspection).
TEST_TENANT_ID=
TEST_USERNAME=
TEST_PASSWORD=
# Optional: TOTP code if the test account has MFA (MFA_REQUIRED). Blank = skip
# authenticated tests when the account demands MFA.
TEST_TOTP_CODE=

# --- Test data scoping --------------------------------------------------------
# Farm id used by farm-scoped queries (tasks/orders/dashboard/cashFlow/lowStock).
TEST_FARM_ID=farm-1
# Optional ids for deeper REST/GraphQL probes (left blank => those steps SKIP).
TEST_ITEM_ID=
TEST_WAREHOUSE_ID=
TEST_BATCH_ID=

# --- Behavior flags -----------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30
# Set false if gateway introspection is disabled by security config; the suite
# then treats a blocked introspection query as expected, not a failure.
GRAPHQL_INTROSPECTION_ENABLED=true
# Guard for data-mutating/destructive GraphQL mutations and REST writes. Default
# OFF. Only turn on against a disposable test tenant.
ALLOW_DESTRUCTIVE_TESTS=false

# --- Direct service health ports (verified from each service application.yml) -
# Used only by health/test-health.sh when probing services directly (not via GW).
# Actuator /actuator/health is exposed on each service's HTTP server.port.
IDENTITY_HEALTH_URL=http://localhost:8092
LIVESTOCK_HEALTH_URL=http://localhost:8081
INVENTORY_HEALTH_URL=http://localhost:8083
FINANCE_HEALTH_URL=http://localhost:8084
ORDER_HEALTH_URL=http://localhost:8085
REPORTING_HEALTH_URL=http://localhost:8086
HEALTH_SERVICE_HEALTH_URL=http://localhost:8087
READINESS_HEALTH_URL=http://localhost:8090
