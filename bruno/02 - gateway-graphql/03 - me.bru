meta {
  name: 03 - me
  type: graphql
  seq: 3
}

post {
  url: {{gatewayUrl}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:graphql {
  query {
    me {
      userId
      email
      roles
      scopes
    }
  }
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
}

docs {
  Current-user query from the committed SDL (`me`). Confirms the token resolves to a
  user with roles/scopes. If `errors` mentions a missing field, the live schema differs
  from the SDL — compare with `01 - introspection`.
}
