meta {
  name: 03 - me
  type: graphql
  seq: 3
}

post {
  url: {{gatewayUrl}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:graphql {
  query {
    me {
      subjectId
      active
      version
      profile { displayName email firstName lastName phoneNumber locale timeZone emailVerified phoneVerified }
      membership { membershipId tenantId status roles farmIds }
    }
  }
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
}

docs {
  Current-user query from the committed SDL (`me` → `Principal`). Returns profile + membership
  (roles/farmIds). NOTE: `Principal` has **no** `scopes` field — scopes come from the JWT access
  token (`scope`/`scopes` claim), not from GraphQL. Thin REST `/api/v1/me` only returns
  `{subject, tenantId}`. If `errors` mentions a missing field, the live schema differs from the
  SDL — compare with `01 - introspection`.
}
