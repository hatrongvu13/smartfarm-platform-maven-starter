post {
  url: {{gatewayUrl}}/api/v1/order-sagas/{{sagaId}}/mark-resolved
  body: json
  auth: bearer
}

auth:bearer { token: {{accessToken}} }
body:json { { "reason": "manual reconciliation completed" } }

tests { test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); }); }

docs { Requires `orders:saga:admin`. Preserve the incident/reconciliation reference in `reason`. }
