meta {
  name: 11 - async-saga-execution-flow
  type: http
  seq: 11
}

post {
  url: {{gatewayUrl}}/api/v1/orders/drafts/{{orderId}}/submit
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "expectedVersion": {{orderVersion}}
  }
}

script:post-response {
  const b = res.getBody() || {};
  if (b.version !== undefined) bru.setEnvVar("orderVersion", String(b.version));
  if (b.orderId) bru.setEnvVar("orderId", b.orderId);
  if (b.status) bru.setVar("orderStatus", b.status);
}

tests {
  test("HTTP 200 - Order submitted for async Saga processing", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Order status transitioned to processing or submitted", function () {
    expect(res.getBody().status).to.be.oneOf(["ORDER_STATUS_SUBMITTED", "ORDER_STATUS_PROCESSING", "ORDER_STATUS_COMPLETED"]);
  });
}

docs {
  # Kịch bản kiểm thử luồng Bất đồng bộ (Async Saga Flow & Token Delegation)

  1. Client gửi request `submit draft order` qua API Gateway kèm User Access Token (Sync, TTL <= 15 phút).
  2. API Gateway thực hiện:
     - Xác thực chữ ký RS256 qua JWKS của Identity Service.
     - Kiểm tra thời gian sống (`exp`, `iat`, `nbf`).
     - Xác thực tính tươi mới (Watermark Freshness).
     - Gọi `IdentityTokenService.ExchangeDelegatedToken` qua gRPC để lấy Delegated Service Token riêng.
  3. Order Service nhận lệnh, khởi tạo đồ thị Order Saga (Forward: Reserve Stock -> Post Finance -> Commit Stock; Compensating: Reverse Finance -> Release Stock).
  4. Worker bất đồng bộ (`OrderSagaPersistentWorker`) chạy nền:
     - Sử dụng Service Token cho luồng Async (`is_async = true`, không bị ràng buộc thời gian hết hạn cố định) để điều phối các bước Saga qua gRPC/MQTT mà không bị đứt gãy do delay hàng đợi hoặc quá hạn token ngắn hạn.
     - Các service đích (`Inventory`, `Finance`) sử dụng `smartfarm-security` xác thực token: chấp nhận `is_async = true` bỏ qua `missing_expiry` nhưng vẫn kiểm tra chặt chẽ chữ ký RSA, `tenant_id`, `client_id` và watermark thu hồi quyền.
}
