meta { name: 01 - create warehouse type: http seq: 1 }
post { url: {{gatewayUrl}}/api/v1/inventory/warehouses body: json auth: bearer }
auth:bearer { token: {{accessToken}} }
body:json { { "farmId":"{{farmId}}", "code":"WH-01", "name":"Kho chính" } }
