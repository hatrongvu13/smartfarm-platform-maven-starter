<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      SmartFarm platform parent + aggregator (single-repo monorepo).

      This POM is BOTH the Maven parent (every module inherits from it) and the
      reactor aggregator (it lists every module). Shared configuration lives here
      exactly once: Spring Boot version, Java version, internal-module versions,
      third-party pins, and plugin management. Add modules under <modules> as you
      create them.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.htv.smartfarm</groupId>
    <artifactId>smartfarm-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SmartFarm Platform</name>
    <description>Single-repo Maven monorepo for the SmartFarm microservices platform.</description>

    <!--
      No modules yet. Add each new module here as you create it, e.g.:
        <module>libs/smartfarm-common-kernel</module>
        <module>services/smartfarm-identity-service</module>
        <module>apps/smartfarm-gateway</module>
    -->
    <modules>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  Managed here so service/app modules enable repackage with an
                  empty <plugin> entry, while library modules simply do not list
                  it (libraries are dependencies, never runnable fat-jars).
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
