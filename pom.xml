<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      FarmVerse — hệ sinh thái học Microservices. Thiết kế: content/thiet-ke-farmverse-msa.md

      POM này vừa là parent (mọi module kế thừa) vừa là aggregator (khai mọi module).
      Version thư viện do BOM quản:
        - Spring Boot 4.1.2 (spring-boot-dependencies): Security, SAS, Session, Testcontainers...
        - Spring Cloud 2025.1.4: Gateway, CircuitBreaker.
      Không ghim version tay cho thứ BOM đã quản.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.htv.farmverse</groupId>
    <artifactId>farmverse-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>FarmVerse</name>
    <description>FarmVerse — microservices learning ecosystem (Spring Boot + Spring Cloud).</description>

    <modules>
        <module>libs/farmverse-starter-service</module>
        <module>services/identity-service</module>
        <module>services/farm-service</module>
        <module>platform/api-gateway</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-cloud.version>2025.1.4</spring-cloud.version>
        <!-- Ngoài Boot BOM: springdoc 3.x cho Spring Boot 4. -->
        <springdoc.version>3.1.1</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Module nội bộ: quản ở đây để module con không ghi version -->
            <dependency>
                <groupId>com.htv.farmverse</groupId>
                <artifactId>farmverse-starter-service</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Test tích hợp chạy trên PostgreSQL thật qua Testcontainers (version do Boot BOM quản). -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Service bật repackage bằng một <plugin> rỗng; lib không khai. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
