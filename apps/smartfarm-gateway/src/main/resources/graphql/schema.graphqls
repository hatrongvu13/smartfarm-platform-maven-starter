type Query {
  platformStatus: PlatformStatus!
  tasks(farmId: ID!, status: String, assigneeId: ID, limit: Int): [Task!]!
  task(id: ID!): Task
  orders(farmId: ID!, status: String, limit: Int): [Order!]!
  order(id: ID!): Order
  dashboard(farmId: ID!, recentLimit: Int): Dashboard!
  warehouseInventory(itemId: ID!, warehouseId: ID!): StockBalance
  batchCost(farmId: ID!, batchId: ID!): BatchCost
  cashFlow(farmId: ID!, fromEpochMs: Float, toEpochMs: Float): CashFlow
  lowStock(farmId: ID!, limit: Int): [StockBalance!]!
  me: Principal!
  users(filter: UserFilter, page: PageInput): UserConnection!
  userAuthorization(subjectId: ID!): UserAuthorization!
  roles(page: PageInput): RoleConnection!
  permissions(page: PageInput): PermissionConnection!
  mySecurityProfile: SecurityProfile!
}
input PageInput { size: Int = 20, token: String }
input UserFilter { searchText: String, roleCode: String }
enum AccountStatus { ACTIVE LOCKED DISABLED UNSPECIFIED }
enum MembershipStatus { INVITED ACTIVE SUSPENDED DISABLED UNSPECIFIED }
enum RoleType { TENANT SYSTEM PLATFORM UNSPECIFIED }
type PlatformStatus { name: String!, status: String!, tenantId: String! }
type Principal { subjectId: ID!, active: Boolean!, version: Float!, profile: PrincipalProfile!, membership: Membership!, createdAt: String!, updatedAt: String! }
type PrincipalProfile { displayName: String!, email: String!, firstName: String, lastName: String, phoneNumber: String, avatarUrl: String, locale: String!, timeZone: String!, emailVerified: Boolean!, phoneVerified: Boolean! }
type Membership { membershipId: ID!, tenantId: ID!, status: MembershipStatus!, roles: [String!]!, farmIds: [ID!]! }
type UserSummary { subjectId: ID!, membershipId: ID!, tenantId: ID!, email: String!, displayName: String!, accountStatus: AccountStatus!, membershipStatus: MembershipStatus!, roles: [String!]!, createdAt: String!, updatedAt: String! }
type UserConnection { nodes: [UserSummary!]!, nextPageToken: String! }
type Permission { code: String!, resourceType: String!, action: String!, description: String! }
type PermissionConnection { nodes: [Permission!]!, nextPageToken: String! }
type Role { roleId: ID!, tenantId: ID!, code: String!, name: String!, type: RoleType!, permissions: [Permission!]!, createdAt: String!, updatedAt: String!, version: Float! }
type RoleConnection { nodes: [Role!]!, nextPageToken: String! }
type UserAuthorization { subjectId: ID!, membershipId: ID!, tenantId: ID!, accountStatus: AccountStatus!, membershipStatus: MembershipStatus!, roles: [Role!]!, effectivePermissions: [Permission!]!, farmIds: [ID!]! }
type Money { currency: String!, minor: Float! }
type Quantity { value: String!, unit: String }
type StockBalance { itemId: String!, warehouseId: String!, onHand: Quantity!, reserved: Quantity!, available: Quantity! }
type BatchCost { batchId: ID!, farmId: ID!, feedCost: Money!, medicineCost: Money!, laborCost: Money!, otherCost: Money!, totalCost: Money!, animalCount: Int! }
type CashFlow { farmId: ID!, inflow: Money!, outflow: Money!, net: Money! }
type Dashboard { farmId: ID!, generatedAt: Float!, tasks: TaskSummary!, orders: OrderSummary!, overdueTasks: [Task!]!, failedOrders: [Order!]! }
type TaskSummary { total: Int!, created: Int!, assigned: Int!, accepted: Int!, completed: Int!, cancelled: Int!, overdueAccept: Int!, overdueReport: Int! }
type OrderSummary { total: Int!, created: Int!, stockReserved: Int!, financePosted: Int!, completed: Int!, failed: Int!, cancelled: Int! }
type Task { taskId: ID!, farmId: ID!, title: String!, type: String!, status: String!, assigneeId: ID, dueAt: Float, assignedAt: Float, acceptDeadlineAt: Float, acceptedAt: Float, reportDueAt: Float, reportedAt: Float, completedAt: Float }
type Order { orderId: ID!, farmId: ID!, batchId: ID, status: String!, totalMinor: Float!, failureReason: String, lines: [OrderLine!]! }
type OrderLine { itemId: ID!, quantity: Float!, unit: String, unitPriceMinor: Float, warehouseId: ID }


type Mutation {
  updateMyProfile(input: UpdateProfileInput!): Principal!
  beginTotpEnrollment(displayName: String): TotpEnrollment!
  confirmTotpEnrollment(authenticatorId: ID!, code: String!): TotpEnrollmentConfirmation!
  disableMyMfa(authenticatorId: ID!): Boolean!
  regenerateRecoveryCodes(authenticatorId: ID!): RecoveryCodeSet!
  changeMyPassword(currentPassword: String!, newPassword: String!): Boolean!
  resetUserMfa(subjectId: ID!): Boolean!
}

input UpdateProfileInput {
  expectedVersion: Float!
  displayName: String
  firstName: String
  lastName: String
  phoneNumber: String
  avatarUrl: String
  locale: String
  timeZone: String
}

type SecurityProfile {
  subjectId: ID!
  totpRequired: Boolean!
  totpEnabled: Boolean!
  authenticators: [Authenticator!]!
}

type Authenticator {
  authenticatorId: ID!
  type: String!
  status: String!
  displayName: String!
}

type TotpEnrollment {
  authenticatorId: ID!
  otpauthUri: String!
  expiresAt: String!
}

type TotpEnrollmentConfirmation {
  authenticatorId: ID!
  recoveryCodes: [String!]!
}

type RecoveryCodeSet {
  recoveryCodes: [String!]!
}
